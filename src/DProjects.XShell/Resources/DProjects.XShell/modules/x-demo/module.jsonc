{
    // app
    "app": {
        "name": "test-app",
        "label": "test app",
        "version": "0.1.0",
        "copyright": "",
        "icon": ""
    },

    // module
    "modules": {
        "x-demo": {
            "label": "test module",
            "version": "1.0.0",
            "styles": [ "/css/styles.css" ],
            "icon": "",
            "copyright": "",
            "controller": "/js/module.js",
            "imports": [
                {"configUrl": "url:../x/module.jsonc", "params": {"aaa":123, "bbb":456}}
            ],
            "defaults": {
                "component": { 
                    "renderEngine": "x",
                    "stateEngine": "proxy"
                },
                "page": { 
                    "renderEngine": "x",
                    "stateEngine": "proxy"
                }
            },
            "contract": {
                "events": {},
                "actions": {},
                "intents": {}
            },
            "menus":{
                "navigation": "x-demo-dynamic-navigation-menu-source",
                "tools": [
                    { "label": "My things 1", "href": "/pages/test1.js"},
                    { "label": "My things 2", "href": "/pages/test1.js"}
                ]
            }
        }
    },

    // xshell 
    "xshell": {
        "areas": {
            "default": "demo",
            "definitions": {
                "demo": {
                    "prefix": "demo",
                    "label": "Demo",
                    "icon": "",
                    "modules": [ "x-demo" ]
                }
            }
        }
    }

}
