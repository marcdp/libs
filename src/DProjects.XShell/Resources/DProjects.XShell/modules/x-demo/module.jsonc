{
    // app
    "app": {
        "name": "test-app",
        "label": "test app",
        "version": "0.1.0",
        "copyright": "",
        "icon": ""
    },

    // module
    "modules": {
        // local root module definition
        "x-demo": {
            "label": "test module",
            "version": "1.0.0",
            "styles": [ "/css/styles.css" ],
            "icon": "",
            "copyright": "",
            "controller": "/js/module.js",
            "defaults": {
                "component": { 
                    "renderEngine": "x",
                    "stateEngine": "proxy"
                },
                "page": { 
                    "renderEngine": "x",
                    "stateEngine": "proxy"
                }
            },
            "contract": {
                "events": {},
                "actions": {},
                "intents": {}
            },
            "menus":{
                "navigation": "x-demo-dynamic-navigation-menu-source",
                "tools": [
                    { "label": "My things 1", "href": "/pages/01-components/index.js?a=1"},
                    { "label": "My things 2", "href": "/pages/index.js?a=2"}
                ]
            },
            "routes":{
                "/something": "/pages/index.js",
                "/repository/{repositoryId}/projects/{projectId}/items": "/pages/index.js"
            }
        },
        // root application composition reference
        "x": {
            "configUrl": "url:../x/module.jsonc",
            "params": {
                "aaa": 890,
                "bbb": 987
            }
        }
    },

    // xshell 
    "xshell": {
        "areas": {
            "default": "demo",
            "definitions": {
                "demo": {
                    "prefix": "demo",
                    "label": "Demo",
                    "icon": "",
                    "modules": [ "x-demo" ]
                }
            }
        }
    }

}
