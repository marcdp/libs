{

    // module
    "modules": {
        "x-debug": {
            "label": "Debugger module",
            "version": "1.0.0",
            "icon": "",
            "copyright": "",
            "defaults": {
                "component": { 
                    "renderEngine": "x",
                    "stateEngine": "proxy"
                },
                "page": { 
                    "renderEngine": "x",
                    "stateEngine": "proxy"
                }
            },
            "menus": {
                "navigation": [
                    {"label": "Debug", "children":[
                        {"label": "Config", "href": "/pages/config.js"},
                        {"label": "Modules", "href": "/pages/modules.js"},
                        {"label": "Components", "href": "/pages/components.js"},
                        {"label": "Pages", "href": "/pages/pages.js"},
                        {"label": "Navigation", "href": "/pages/navigation.js"},
                        {"label": "Contracts", "href": "/pages/contracts.js"},
                        {"label": "Services", "href": "/pages/services.js"},
                        {"label": "Loader", "href": "/pages/loader.js"},
                        {"label": "Bus", "href": "/pages/bus.js"}
                    ] }
                ],
                "shortcuts": [
                    {"label": "", "tooltip":"Debug", "icon": "x-debug", "children":[
                        {"label": "Shortcut 1.1", "href": "/pages/index.js", "icon": "x-settings", "embeded": true }
                    ] }
                ]
            }
        }
    },

    // xshell 
    "xshell": {
        "areas": {
            "definitions": {
                "debug": {
                    "prefix": "debug",
                    "label": "Debug",
                    "icon": "",
                    "modules": [ "x-debug" ]
                }
            }
        }
    }

}
