{
    //"$schema": "../../xshell/schemes/config.scheme.json",

    // module
    "modules": {
        "x": {
            "label": "X module",
            "version": "1.0.0",
            "styles": [ "/css/styles.css" ],
            "copyright": "",
            "imports": [],
            "icon": "",
            "defaults": {
                "component": { 
                    "renderEngine": "x",
                    "stateEngine": "proxy"
                },
                "page": { 
                    "renderEngine": "x",
                    "stateEngine": "proxy"
                }
            },
            "controller": "./js/module.js",
            "contract": {
                "events": {},
                "actions": {},
                "intents": {}
            }
        }
    },

    // resolver
    "xshell": {
        // resolver
        "resolver": {
            "component": {
                "ace-editor": { "url": "https://unpkg.com/ace-custom-element@latest/dist/index.min.js", "loader": "module-js"}
            }
        },

        // ui
        "ui": {
            "layout": {
                "default": "x-layout-default",
                "dialog": "x-layout-dialog",
                "main": "x-layout-main",
                "stack": "x-layout-stack",
                "embed": "x-layout-embed"
            },
            "dialog": {
                "confirm": "/pages/dialog-confirm.js",
                "message": "/pages/dialog-message.js",
                "prompt": "/pages/dialog-prompt.js",
                "picker": "/pages/dialog-picker.js"
            },
            "component": {
                "lazy": "x-lazy",
                "error": "x-error"
            }
        }
        
    }
}