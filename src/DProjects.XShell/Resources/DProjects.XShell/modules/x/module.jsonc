{
    //"$schema": "../../xshell/schemes/config.scheme.json",

    // module
    "modules": {
        "x": {
            "label": "X module",
            "version": "1.0.0",
            "styles": [ "/css/styles.css" ],
            "copyright": "",
            "imports": [],
            "icon": "",
            "defaults": {
                "page": {
                    "renderEngine": "x",
                    "stateEngine": "proxy"
                },
                "dialog": {
                    "confirm": null,
                    "message": null,
                    "prompt": null
                }
            },
            "controller": "./js/module.js"
        }
    },

    // resolver
    "xshell": {
        // resolver
        "resolver": {
            "component": {
                "ace-editor": {
                    "url": "https://unpkg.com/ace-custom-element@latest/dist/index.min.js",
                    "loader": "module-js"
                }
            },
            "import": {
                "marked": {
                    "url": "/vendor/marked/marked.esm.js"
                },
                "json-schema": {
                    "url": "/vendor/json-schema/json-schema.js"
                },
                "x-element": {
                    "url": "/controllers/x-element.js"
                }
            }
        },

        // defaults
        "defaults": {
            "page": {
                "layout": {
                    "default": "x-layout-default",
                    "dialog": "x-layout-dialog",
                    "main": "x-layout-main",
                    "stack": "x-layout-stack",
                    "embed": "x-layout-embed"
                }
            },
            "dialog": {
                "confirm": "/pages/dialog-confirm.js",
                "message": "/pages/dialog-message.js",
                "prompt": "/pages/dialog-prompt.js",
                "picker": "/pages/dialog-picker.js"
            },
            "component": {
                "renderEngine": "x",
                "stateEngine": "proxy",
                "lazy": "x-lazy",
                "error": "x-error"
            }
        }
        
    }
}