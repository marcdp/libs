{
    // module
    "modules": {
        "x": {
            "label": "X module",
            "version": "1.0.0",
            "styles": [ "/css/styles.css" ],
            "icon": "",
            "page": {
                "renderEngine": "x",
                "stateEngine": "proxy",
                "dialog": {
                    "confirm": null,
                    "message": null,
                    "prompt": null
                }
            },
            "component": {
                "renderEngine": "x",
                "stateEngine": "proxy"
            }
        }
    },

    // resolver
    "xshell": {
        // resolver
        "resolver": {
            "component": {
                "ace-editor": {
                    "url": "https://unpkg.com/ace-custom-element@latest/dist/index.min.js",
                    "loader": "module-js"
                }
            },
            "import": {
                "marked": {
                    "url": "/vendor/marked/marked.esm.js"
                },
                "x-element": {
                    "url": "/controllers/x-element.js"
                }
            }
        },

        // pages
        "page": {
            "layout": {
                "default": "x-layout-default",
                "dialog": "x-layout-dialog",
                "main": "x-layout-main",
                "stack": "x-layout-stack",
                "embed": "x-layout-embed"
            }
        },

        // components
        "component": {
            "lazy": "x-lazy",
            "error": "x-error"
        },

        // dialogs
        "dialog": {
            "confirm": "/pages/dialog-confirm.js",
            "message": "/pages/dialog-message.js",
            "prompt": "/pages/dialog-prompt.js",
            "picker": "/pages/dialog-picker.js"
        }
    }
}