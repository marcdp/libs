{

    // module
    "modules": {
        "xshell-docs": {
            "label": "XShell docs",
            "version": "1.0.0",
            "icon": "xshell-docs",
            "copyright": "",
            "defaults": {
                "component": { 
                    "renderEngine": "x",
                    "stateEngine": "proxy"
                },
                "page": { 
                    "renderEngine": "x",
                    "stateEngine": "proxy"
                }
            },
            "menus": {
                "navigation": "/pages"
            }
        }
    },

    // xshell 
    "xshell": {
        "areas": {
            "definitions": {
                "xshell-docs": {
                    "prefix": "xshell-docs",
                    "label": "XShell docs",
                    "icon": "xshell-docs",
                    "modules": [ "xshell-docs" ]
                }
            }
        }
    }

}
