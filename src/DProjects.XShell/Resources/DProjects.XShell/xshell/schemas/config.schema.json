{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xshell.dev/schemes/config.scheme.json",
  "title": "XShell Effective Configuration",
  "description": "Schema for the final merged and normalized XShell configuration passed to xshell.init().",
  "type": "object",
  "required": ["app", "modules", "xshell"],
  "properties": {
    "app": {"$ref": "#/$defs/app"},
    "modules": {"type": "object", "additionalProperties": {"$ref": "#/$defs/module"}},
    "xshell": {"$ref": "#/$defs/xshell"}
  },
  "additionalProperties": false,
  "$defs": {
    "app": {
      "type": "object",
      "properties": {
        "name": {"type": "string"},
        "label": {"type": "string"},
        "version": {"type": "string"},
        "copyright": {"type": "string"},
        "icon": {"type": "string"},
        "basePath": {"type": "string"},
        "params": {"type": "object", "additionalProperties": true}
      },
      "required": ["name", "label", "version", "copyright", "icon", "basePath", "params"],
      "additionalProperties": false
    },
    "module": {
      "type": "object",
      "properties": {
        "label": {"type": "string"},
        "version": {"type": "string"},
        "copyright": {"type": "string"},
        "icon": {"type": "string"},
        "url": {"type": "string", "format": "uri"},
        "params": {"type": "object", "additionalProperties": true},
        "styles": {"type": "array", "items": {"type": "string"}},
        "controller": {"type": "string"},
        "imports": {"type": "array", "items": {"$ref": "#/$defs/moduleImport"}},
        "menus": {"$ref": "#/$defs/menus"},
        "defaults": {"$ref": "#/$defs/defaults"}
      },
      "required": ["label", "version", "copyright", "icon", "url"],
      "additionalProperties": false
    },
    "moduleImport": {
      "type": "object",
      "required": ["url"],
      "properties": {
        "url": {"type": "string", "format": "uri"},
        "params": {"type": "object", "additionalProperties": true}
      },
      "additionalProperties": false
    },
    "menus": {"type": "object", "additionalProperties": {"type": "array", "items": {"$ref": "#/$defs/menuItem"}}},
    "menuItem": {
      "type": "object",
      "required": ["label"],
      "properties": {
        "label": {"type": "string"},
        "href": {"type": ["string", "null"]},
        "icon": {"type": ["string", "null"]},
        "default": {"type": "boolean"},
        "children": {"type": "array", "items": {"$ref": "#/$defs/menuItem"}},
        "childrenSource": {"type": "string"}
      },
      "additionalProperties": false
    },
    "xshell": {
      "type": "object",
      "required": ["build", "debug", "version", "environment", "identity", "assetsPrefix", "areas", "navigation", "resolver", "defaults"],
      "properties": {
        "build": {"type": "string"},
        "debug": {"type": "boolean"},
        "version": {"type": "string"},
        "environment": {"type": "string"},
        "defaults": {"$ref": "#/$defs/defaults"},
        "identity": {"$ref": "#/$defs/identity"},
        "assetsPrefix": {"type": "string"},
        "areas": {"$ref": "#/$defs/areas"},
        "navigation": {"$ref": "#/$defs/navigation"},
        "resolver": {"$ref": "#/$defs/resolver"}
      },
      "additionalProperties": false
    },
    "areas": {
      "type": "object",
      "required": ["default", "definitions"],
      "properties": {
        "default": {"type": ["string", "null"]},
        "definitions": {"type": "object", "additionalProperties": {"$ref": "#/$defs/area"}}
      },
      "additionalProperties": false
    },
    "area": {
      "type": "object",
      "properties": {
        "prefix": {"type": "string"},
        "label": {"type": "string"},
        "description": {"type": "string"},
        "icon": {"type": ["string", "null"]},
        "modules": {"type": "array", "items": {"type": "string"}},
        "order": {"type": "number"}
      },
      "additionalProperties": false
    },
    "navigation": {
      "type": "object",
      "required": ["mode"],
      "properties": {
        "mode": {"type": "string", "enum": ["hash", "path"]},
        "hashPrefix": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },

    "defaults": {
      "type": "object",
      "required": [],
      "properties": {
        "page": {"$ref": "#/$defs/pageDefaults"},
        "dialog": {"$ref": "#/$defs/dialogDefaults"},
        "component": {"$ref": "#/$defs/componentDefaults"}
      },
      "additionalProperties": false
    },
    "pageDefaults": {
      "type": "object",
      "properties": {
        "layout": {
          "type": "object",
          "properties": {
            "default": {"type": ["string", "null"]},
            "dialog": {"type": ["string", "null"]},
            "main": {"type": ["string", "null"]},
            "stack": {"type": ["string", "null"]},
            "embed": {"type": ["string", "null"]}
          },
          "additionalProperties": {"type": ["string", "null"]}
        },
        "renderEngine": {"type": ["string", "null"]},
        "stateEngine": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },    
    "componentDefaults": {
      "type": "object",
      "required": ["lazy", "error", "renderEngine", "stateEngine"],
      "properties": {
        "lazy": {"type": ["string", "null"]},
        "error": {"type": ["string", "null"]},
        "renderEngine": {"type": ["string", "null"]},
        "stateEngine": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "dialogDefaults": {
      "type": "object",
      "properties": {
        "confirm": {"type": ["string", "null"]},
        "message": {"type": ["string", "null"]},
        "prompt": {"type": ["string", "null"]},
        "picker": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "identity": {
      "type": "object",
      "required": ["provider"],
      "properties": {
        "provider": {"type": "string"},
        "params": {"type": "object", "additionalProperties": true}
      },
      "additionalProperties": false
    },
    "resolver": {"type": "object", "additionalProperties": {"type": "object", "additionalProperties": {"$ref": "#/$defs/resolverEntry"}}},
    "resolverEntry": {
      "type": "object",
      "required": ["url"],
      "properties": {
        "url": {"type": "string"},
        "loader": {"type": "string"},
        "cache": {"type": "boolean"},
        "moduleId": {"type": "string"},
        "modulePath": {"type": "string"}
      },
      "additionalProperties": false
    }
  }
}
