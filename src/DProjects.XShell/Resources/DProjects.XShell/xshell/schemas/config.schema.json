{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xshell.dev/schemas/config.schema.json",
  "title": "XShell Effective Configuration",
  "type": "object",
  "required": ["app", "modules", "xshell"],
  "properties": {
    "app": {"$ref": "#/$defs/app", "description": "Application metadata and runtime parameters."},
    "modules": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/module"},
      "description": "Resolved modules participating in the application."
    },
    "xshell": {"$ref": "#/$defs/xshell", "description": "XShell runtime configuration."}
  },
  "additionalProperties": false,
  "$defs": {
    "app": {
      "type": "object",
      "properties": {
        "id": {"type": "string", "description": "Application identifier."},
        "label": {"type": "string", "description": "Human-readable application label."},
        "version": {"type": "string", "description": "Application version."},
        "copyright": {"type": "string", "description": "Application copyright notice."},
        "icon": {"type": "string", "description": "Application icon resource."},
        "basePath": {"type": "string", "description": "Base path under which the application is hosted."},
        "baseUrl": {"type": "string", "description": "Base absolute URL under which the application is hosted."},
        "params": {"type": "object", "additionalProperties": true, "description": "Application-specific parameters."}
      },
      "required": ["id", "label", "version", "copyright", "icon", "basePath", "params"],
      "additionalProperties": false,
      "description": "Application metadata, base path, and application parameters."
    },
    "module": {
      "type": "object",
      "properties": {
        "label": {"type": "string", "description": "Human-readable module label."},
        "version": {"type": "string", "description": "Module version."},
        "copyright": {"type": "string", "description": "Module copyright notice."},
        "icon": {"type": "string", "description": "Module icon resource."},
        "configUrl": {"type": "string", "format": "uri", "description": "URL of the module configuration document."},
        "params": {"type": "object", "additionalProperties": true, "description": "Parameters supplied to the canonical module by root application composition."},
        "requires": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true, "description": "Names of services that must be registered before the module is initialized."},
        "assetsUrl": {"type": "string", "format": "uri", "description": "URL of the directory or package containing the module assets, absolute."},
        "assetsPath": {"type": "string", "pattern": "^/", "description": "Application-root-relative virtual base path for the module assets."},
        "menus": {"$ref": "#/$defs/menus", "description": "Menu contributions exposed by the module."},
        "routes": {
          "type": "object",
          "additionalProperties": {"type": "string"},
          "description": "Declarative application URL patterns mapped to module-relative Page targets."
        },
        "defaults": {"$ref": "#/$defs/moduleDefaults", "description": "Defaults for that module."},
        "contract": {"$ref": "#/$defs/moduleContract", "description": "Public contract exposed by the module."},
        "files": {"type": "array", "items": {"$ref": "#/$defs/file"}, "description": "Normalized virtual resource inventory for the module."}
      },
      "required": ["label", "version", "copyright", "icon", "configUrl", "assetsUrl", "defaults", "files", "assetsPath"],
      "additionalProperties": false,
      "description": "Effective configuration of a resolved XShell module."
    },
    "file": {
      "type": "object",
      "properties": {
        "path": {"type": "string", "minLength": 1, "description": "Absolute or application-root-relative virtual resource path."},
        "size": {"type": "integer", "minimum": 0, "description": "Size of the physical file in bytes."},
        "hash": {"type": "string", "minLength": 1, "description": "Hash of the physical file content."}
      },
      "required": ["path", "size", "hash"],
      "additionalProperties": false,
      "description": "File entry in the effective XShell resource inventory."
    },
    "moduleDefaults": {
      "type": "object",
      "required": ["page","component"],
      "properties": {
        "page": {"$ref": "#/$defs/modulePageDefaults", "description": "Defaults applied to pages."},
        "component": {"$ref": "#/$defs/moduleComponentDefaults", "description": "Defaults applied to components."}
      },
      "additionalProperties": false,
      "description": "Default values used by pages and components of this module."
    },
    "modulePageDefaults": {
      "type": "object",
      "required": ["renderEngine","stateEngine"],
      "properties": {
        "renderEngine": {"type": "string", "minLength": 1 , "description": "Default render engine used by pages."},
        "stateEngine": {"type": "string", "minLength": 1 , "description": "Default state engine used by pages."}
      },
      "additionalProperties": false,
      "description": "Default settings applied to pages."
    },
    "moduleComponentDefaults": {
      "type": "object",
      "required": ["renderEngine", "stateEngine"],
      "properties": {
        "renderEngine": {"type": "string", "minLength": 1 , "description": "Default render engine used by components."},
        "stateEngine": {"type": "string", "minLength": 1 , "description": "Default state engine used by components."}
      },
      "additionalProperties": false,
      "description": "Default settings applied to components."
    },
    "moduleContract": {
      "type": "object",
      "properties": {
        "events": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "detail": {
                "type": "object",
                "additionalProperties": {
                  "type": "object",
                  "properties": {
                    "type": {"type": "string", "enum": ["string", "number", "integer", "boolean", "object", "array"]},
                    "required": {"type": "boolean"},
                    "default": {},
                    "description": {"type": "string"}
                  },
                  "required": ["type"],
                  "additionalProperties": false,
                  "description": "Definition of an event detail field."
                },
                "description": "Fields carried in the event detail payload."
              },
              "description": {"type": "string"}
            },
            "additionalProperties": false,
            "description": "Definition of a module event."
          },
          "description": "Events published by the module."
        },
        "actions": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "input": {
                "type": "object",
                "additionalProperties": {
                  "type": "object",
                  "properties": {
                    "type": {"type": "string", "enum": ["string", "number", "integer", "boolean", "object", "array"]},
                    "required": {"type": "boolean"},
                    "default": {},
                    "description": {"type": "string"}
                  },
                  "required": ["type"],
                  "additionalProperties": false,
                  "description": "Definition of an action input field."
                },
                "description": "Named input fields accepted by the action."
              },
              "output": {
                "type": "object",
                "properties": {
                  "type": {"type": "string", "enum": ["string", "number", "integer", "boolean", "object", "array"]},
                  "description": {"type": "string"}
                },
                "required": ["type"],
                "additionalProperties": false,
                "description": "Value returned by the action."
              },
              "description": {"type": "string"}
            },
            "additionalProperties": false,
            "description": "Definition of a module action."
          },
          "description": "Request-response actions exposed by the module."
        },
        "intents": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "input": {
                "type": "object",
                "additionalProperties": {
                  "type": "object",
                  "properties": {
                    "type": {"type": "string", "enum": ["string", "number", "integer", "boolean", "object", "array"]},
                    "required": {"type": "boolean"},
                    "default": {},
                    "description": {"type": "string"}
                  },
                  "required": ["type"],
                  "additionalProperties": false,
                  "description": "Definition of an intent input field."
                },
                "description": "Named input fields accepted by the intent."
              },
              "description": {"type": "string"}
            },
            "additionalProperties": false,
            "description": "Definition of a module intent."
          },
          "description": "Fire-and-forget intents accepted by the module."
        }
      },
      "additionalProperties": false,
      "description": "Public events, actions, and intents exposed by a module."
    },
    "menus": {
      "type": "object",
      "additionalProperties": {
        "oneOf": [
          { "type": "array", "items": {"$ref": "#/$defs/menuItem"}},
          { "type": "string", "minLength": 1, "description": "A module-relative inventory path beginning with /, or a registered runtime menu source name."}
        ],
        "description": "Static items, a module-relative inventory path, or a registered runtime source name."
      },
      "description": "Named menu contributions provided by a module."
    },
    "menuItem": {
      "type": "object",
      "required": ["label"],
      "properties": {
        "label": {"type": "string", "description": "Human-readable menu item label."},
        "href": {"type": ["string", "null"], "description": "Canonical XShell navigation target associated with the menu item."},
        "path": {"type": "string", "description": "Optional public navigation path used as a friendly alias for href."},
        "icon": {"type": ["string", "null"], "description": "Optional icon associated with the menu item."},
        "embeded": {"type": "boolean", "description": "Whether the menu item should be embedded."},
        "default": {"type": "boolean", "description": "Whether this item is the default navigation target."},
        "tooltip": {"type": ["string", "null"], "description": "Optional tooltip text for the menu item."},
        "class": {"type": "string", "description": "CSS class to apply to the menu item."},
        "children": {
          "type": "array",
          "items": {"$ref": "#/$defs/menuItem"},
          "description": "Nested menu items."
        },
        "childrenSource": {"type": "string", "description": "Resource used to populate child menu items dynamically."}
      },
      "additionalProperties": false,
      "description": "A navigable menu item with optional children."
    },
    "xshell": {
      "type": "object",
      "required": ["build", "debug", "version", "environment", "assetsBasePath", "assetsPath", "areas", "navigation", "resolver", "ui", "i18n", "configUrl", "assetsUrl", "files"],
      "properties": {
        "build": {"type": "string", "description": "XShell build identifier."},
        "debug": {"type": "boolean", "description": "Whether XShell debug behavior is enabled."},
        "version": {"type": "string", "description": "XShell runtime version."},
        "environment": {"type": "string", "description": "Runtime environment name."},
        "configUrl": {"type": "string", "format": "uri", "description": "URL of the xshell configuration document"},
        "assetsBasePath": {"type": "string", "pattern": "^/", "description": "Normalized application-relative base path for the virtual asset namespace. (e.g. /_assets)"},
        "assetsPath": {"type": "string", "pattern": "^/", "description": "Application-root-relative virtual base path for the XShell framework assets. (e.g. /_assets/xshell)"},
        "assetsUrl": {"type": "string", "format": "uri", "description": "URL of the directory or package containing the xshell assets."},
        "ui": {"$ref": "#/$defs/xshellUi", "description": "Global ui settings."},
        "i18n": {"$ref": "#/$defs/xshellI18n", "description": "Language, translation, and date/time formatting settings."},
        "areas": {"$ref": "#/$defs/xshellAreas", "description": "Application area configuration."},
        "navigation": {"$ref": "#/$defs/xshellNavigation", "description": "Navigation configuration."},
        "resolver": {"$ref": "#/$defs/resolver", "description": "Logical resource resolver configuration."},
        "services": {"$ref": "#/$defs/xshellServices", "description": "Services configuration."},
        "temp": {"$ref": "#/$defs/xshellTemp", "description": "Temp configuration."},
        "files": {"type": "array", "items": {"$ref": "#/$defs/file"}, "description": "Normalized virtual resource inventory for the XShell framework."}
      },
      "additionalProperties": false,
      "description": "Core XShell runtime configuration."
    },
    "xshellI18n": {
      "type": "object",
      "required": ["lang", "langs", "datetime", "strings"],
      "properties": {
        "lang": {"type": "string", "minLength": 1, "description": "Current application language."},
        "langs": {
          "type": "array",
          "items": {"$ref": "#/$defs/xshellI18nLanguage"},
          "description": "Languages available to the application."
        },
        "datetime": {"$ref": "#/$defs/xshellI18nDateTime", "description": "Default and named date/time formatting options."},
        "strings": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": {"type": "string"}
          },
          "description": "Translation dictionaries keyed by language id."
        }
      },
      "additionalProperties": false,
      "description": "Internationalization service configuration."
    },
    "xshellI18nLanguage": {
      "type": "object",
      "required": ["id", "label"],
      "properties": {
        "id": {"type": "string", "minLength": 1, "description": "Language identifier used by Intl and translation dictionaries."},
        "label": {"type": "string", "description": "Human-readable language label."},
        "main": {"type": "boolean", "description": "Whether the language is included in the main application language set."}
      },
      "additionalProperties": false,
      "description": "Language available to the application."
    },
    "xshellI18nDateTime": {
      "type": "object",
      "required": ["options", "formats"],
      "properties": {
        "options": {"type": "object", "additionalProperties": true, "description": "Default Intl.DateTimeFormat options."},
        "formats": {
          "type": "object",
          "additionalProperties": {"type": "object", "additionalProperties": true},
          "description": "Named Intl.DateTimeFormat option sets."
        }
      },
      "additionalProperties": false,
      "description": "Date/time formatting configuration."
    },
    "xshellAreas": {
      "type": "object",
      "required": ["default", "global", "definitions"],
      "properties": {
        "default": {"type": ["string", "null"], "description": "Identifier of the default area."},
        "global": { "type": "array", "items": {"type": "string"}, "description": "Global menu names."},
        "definitions": {"type": "object", "additionalProperties": {"$ref": "#/$defs/xshellArea"}, "description": "Area definitions keyed by area identifier."}
      },
      "additionalProperties": false,
      "description": "Application areas and the default active area."
    },
    "xshellArea": {
      "type": "object",
      "properties": {
        "prefix": {"type": "string", "description": "URL prefix assigned to the area."},
        "label": {"type": "string", "description": "Human-readable area label."},
        "icon": {"type": ["string", "null"], "description": "Optional icon associated with the area."},
        "modules": {
          "type": "array",
          "items": {"type": "string"},
          "description": "Modules composed into the area, in composition order."
        },
        "order": {"type": "number", "description": "Optional ordering value for the area."},
        "description": {"type": "string", "description": "Human-readable area description."}
      },
      "additionalProperties": false,
      "description": "Configuration of a navigation area."
    },
    "xshellNavigation": {
      "type": "object",
      "required": ["mode"],
      "properties": {
        "mode": {"type": "string", "enum": ["hash", "path"], "description": "Navigation strategy used by the application."},
        "hashPrefix": {"type": ["string", "null"], "description": "Prefix used for hash-based navigation."}
      },
      "additionalProperties": false,
      "description": "Application navigation mode and related options."
    },
    "xshellUi": {
      "type": "object",
      "required": ["layout","component","dialog"],
      "properties": {
        "layout": {"$ref": "#/$defs/xshellUiLayout", "description": "Default layouts available to pages."},
        "component": {"$ref": "#/$defs/xshellUiComponent", "description": "Defaults applied to components."},
        "dialog": {"$ref": "#/$defs/xshellUiDialog", "description": "Defaults dialogs available."},
        "page": {"$ref": "#/$defs/xshellUiPage", "description": "Defaults page resources available."}
      },
      "additionalProperties": false,
      "description": "Default values inherited by pages, dialogs, and components."
    },
    "xshellUiLayout": {
      "type": "object",
      "required": [],
      "properties": {
        "default": {"type": ["string", "null"], "description": "Default page layout."},
        "dialog": {"type": ["string", "null"], "description": "Default dialog page layout."},
        "main": {"type": ["string", "null"], "description": "Default main page layout."},
        "stack": {"type": ["string", "null"], "description": "Default stacked page layout."},
        "embed": {"type": ["string", "null"], "description": "Default embedded page layout."}
      },
      "additionalProperties": {"type": ["string", "null"]},
      "description": "Default layouts available to pages."
    },
    "xshellUiComponent": {
      "type": "object",
      "required": [],
      "properties": {
        "lazy": {"type": ["string", "null"], "description": "Component used for lazy-loading placeholders."},
        "error": {"type": ["string", "null"], "description": "Component used to render component loading errors."},
        "markdown": {"type": ["string", "null"], "description": "Component used to render Markdown content."}
      },
      "additionalProperties": false,
      "description": "Default settings applied to components."
    },
    "xshellUiDialog": {
      "type": "object",
      "properties": {
        "confirm": {"type": ["string", "null"], "description": "Page used for confirmation dialogs."},
        "message": {"type": ["string", "null"], "description": "Page used for message dialogs."},
        "prompt": {"type": ["string", "null"], "description": "Page used for prompt dialogs."},
        "picker": {"type": ["string", "null"], "description": "Page used for picker dialogs."}
      },
      "additionalProperties": false,
      "description": "Default page resources used for standard dialogs."
    },
    "xshellUiPage": {
      "type": "object",
      "properties": {
      },
      "additionalProperties": false,
      "description": "Default page resources used for standard pages."
    },
    "resolver": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": {"$ref": "#/$defs/resolverEntry"},
        "description": "Resolver entries for a logical resource category."
      },
      "description": "Resolver tables used to translate logical resources into concrete resources."
    },
    "resolverEntry": {
      "type": "object",
      "required": ["url"],
      "properties": {
        "url": {"type": "string", "description": "Concrete resource URL or URL template."},
        "loader": {"type": "string", "description": "Loader used to load the resolved resource."},
        "cache": {"type": "boolean", "description": "Whether the resolved resource may be cached."},
        "cacheMode": {"type": "string", "enum": ["full", "path"], "default": "full", "description": "Cache identity strategy. Full includes the query; path excludes it."},
        "moduleId": {"type": "string", "description": "Identifier of the module that owns the resource."},
        "modulePath": {"type": "string", "description": "Virtual asset path of the module that owns the resource."}
      },
      "additionalProperties": false,
      "description": "Resolution rule for a concrete resource."
    },
    "xshellTemp": {
      "type": "object",
      "required": ["url"],
      "properties": {
        "url": {"type": "string", "description": "Absolute browser URL for temporary storage after host-path normalization (e.g. https://example.test/temp)."}
      },
      "additionalProperties": false,
      "description": "Temporary storage configuration."
    },
    "xshellServices": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/xshellService"
      },
      "description": "Configuration for various services."
    },
    "xshellService": {
      "type": "object",
      "required": ["contract", "implementation"],
      "properties": {
        "contract": {"type": "string", "description": "Service contract identifier."},
        "implementation": {"type": "string", "description": "Service implementation URL or path."}
      },
      "additionalProperties": false,
      "description": "Configuration for a single service."
    }
  },
  "description": "Schema for the final merged and normalized XShell configuration passed to xshell.init()."
}
