{
    // app
    "app": {
        "name": "",
        "label": "",
        "copyright": "",
        "icon": "",
        "version": "0.1.0",
        "basePath": ""        
    },

    // modules
    "modules": {},

    // xshell
    "xshell": {

        // core
        "build": "2026-09-21",
        "debug": false,
        "version": "0.9.0",
        "environment": "development",
        "assetsPrefix": "_assets",

        // defaults
        "defaults": {
            "page": {
                "layout": {
                    "default": null,
                    "dialog": null,
                    "main": null,
                    "stack": null,
                    "embed": null
                },
                "renderEngine": "plain",
                "stateEngine": "plain"
            },
            "dialog": {
                "confirm": null,
                "message": null,
                "prompt": null,
                "picker": null
            },
            "component": {
                "lazy": "",
                "error": "",
                "renderEngine": "plain",
                "stateEngine": "plain"
            }
        },

        // identity
        "identity": {
            "provider": "anonymous"
        },

        // areas
        "areas": {
            "default": "main",
            "definitions": {
                "main": {
                    "prefix": "",
                    "label": "Main area",
                    "icon": "x-bell",
                    "modules": [ ]
                }
            }
        },

        // navigation
        "navigation": {
            "mode": "hash", // | "path"
            "hashPrefix": "#!"
        },

        // resolver
        "resolver": {
            "component": {
                "x-page": {"url": "/x-page.js", "loader": "module-js", "cache": true}
            },
            "import": {
                "xshell": {"url": "/xshell.js"}
            },
            "idp": {
                "{name}": {"url": "/idp/{name}.js", "loader": "module-js"}
            },
            "render-engine": {
                "{name}": {"url": "/render-engines/{name}.js","loader": "module-js"}
            },
            "state-engine": {
                "{name}": {"url": "/state-engines/{name}.js","loader": "module-js"}
            }
        }
    }
}
