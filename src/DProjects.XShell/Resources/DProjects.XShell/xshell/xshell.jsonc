{
    // xshell
    "xshell": {

        // core
        "build": "2025-12-06",
        "debug": false,
        "version": "0.9.0",

        // defaults
        "page": {
            "layout": {
                "default": null,
                "dialog": null,
                "main": null,
                "stack": null,
                "embed": null
            },
            "renderEngine": "plain",
            "stateEngine": "plain"
        },
        "dialog": {
            "confirm": null,
            "message": null,
            "prompt": null,
            "picker": null
        },
        "component": {
            "lazy": "",
            "error": "",
            "renderEngine": "plain",
            "stateEngine": "plain"
        },
        "identity": {
            "provider": "anonymous"
        },
        "assetsPrefix": "_assets",
        "areaDefault": "main",

        // navigation
        "navigation": {
            // "mode": "path",
            "mode": "hash",
            "hashPrefix": "#!"
        },

        // resolver
        "resolver": {
            "component": {
                "x-page": {
                    "url": "/x-page.js",
                    "loader": "module-js",
                    "cache": true
                }
            },
            "import": {
                "xshell": {
                    "url": "/xshell.js"
                }
            },
            "idp": {
                "{name}": {
                    "url": "/idp/{name}.js",
                    "loader": "module-js"
                }
            },
            "render-engine": {
                "{name}": {
                    "url": "/render-engines/{name}.js",
                    "loader": "module-js"
                }
            },
            "state-engine": {
                "{name}": {
                    "url": "/state-engines/{name}.js",
                    "loader": "module-js"
                }
            }
        }
    }
}