{
    // app
    "app": {
        "name": "",
        "label": "",
        "copyright": "",
        "icon": "",
        "version": "0.1.0",
        "basePath": ""        
    },

    // modules
    "modules": {},

    // xshell
    "xshell": {

        // core
        "build": "2026-09-21",
        "debug": false,
        "version": "0.9.0",
        "environment": "Development",
        "assetsPrefix": "_assets",
        "assetsUrl": "url:./",

        // ui
        "ui": {
            "layout": {
                "default": null,
                "dialog": null,
                "main": null,
                "stack": null,
                "embed": null
            },
            "dialog": {
                "confirm": null,
                "message": null,
                "prompt": null,
                "picker": null
            },
            "component": {
                "lazy": "",
                "error": ""
            }
        },

        // identity
        "identity": {
            "provider": "anonymous"
        },

        // areas
        "areas": {
            "default": "main",
            "definitions": {
            }
        },

        // navigation
        "navigation": {
            "mode": "path", 
            "hashPrefix": "#!"
        },

        // resolver
        "resolver": {
            "component": {
                "x-page": {"url": "/x-page.js", "loader": "module-js", "cache": true}
            },
            "import": {
                "xshell": {"url": "/xshell.js"}
            },
            "idp": {
                "{name}": {"url": "/idp/{name}.js", "loader": "module-js"}
            },
            "render-engine": {
                "{name}": {"url": "/render-engines/{name}.js","loader": "module-js"}
            },
            "state-engine": {
                "{name}": {"url": "/state-engines/{name}.js","loader": "module-js"}
            },
            "schema": {
                "{name}.json": {"url": "/schemas/{name}.json","loader": "object-json"}
            }
        }
    }
}
