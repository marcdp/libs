{
    // app
    "app": {
        "name": "",
        "label": "",
        "copyright": "",
        "icon": "",
        "version": "0.1.0",
        "base": "/"
    },

    // modules
    "modules": {},

    // xshell
    "xshell": {

        // core
        "build": "2025-12-06",
        "debug": false,
        "version": "0.9.0",

        // defaults
        "module": {
            "root":null,
            "rootParams": {}
        },
        "page": {
            "layout": {
                "default": null,
                "dialog": null,
                "main": null,
                "stack": null,
                "embed": null
            },
            "renderEngine": "plain",
            "stateEngine": "plain"
        },
        "dialog": {
            "confirm": null,
            "message": null,
            "prompt": null,
            "picker": null
        },
        "component": {
            "lazy": "",
            "error": "",
            "renderEngine": "plain",
            "stateEngine": "plain"
        },
        "identity": {
            "provider": "anonymous"
        },
        "assetsPrefix": "_assets",
        "areas": {
            "default": "main",
            "definitions": {
                "main": {
                    "prefix": "",
                    "label": "Main area",
                    "icon": "x-bell",
                    "home": null,
                    "modules": [ ]
                }
            }
        },

        // navigation
        "navigation": {
            "mode": "hash", // | "path"
            "hashPrefix": "#!"
        },

        // resolver
        "resolver": {
            "component": {
                "x-page": {
                    "url": "/x-page.js",
                    "loader": "module-js",
                    "cache": true
                }
            },
            "import": {
                "xshell": {
                    "url": "/xshell.js"
                }
            },
            "idp": {
                "{name}": {
                    "url": "/idp/{name}.js",
                    "loader": "module-js"
                }
            },
            "render-engine": {
                "{name}": {
                    "url": "/render-engines/{name}.js",
                    "loader": "module-js"
                }
            },
            "state-engine": {
                "{name}": {
                    "url": "/state-engines/{name}.js",
                    "loader": "module-js"
                }
            }
        }
    }
}