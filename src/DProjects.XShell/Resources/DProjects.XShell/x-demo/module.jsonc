{
    // app
    "app": {
        "id": "x-demo-app",
        "label": "x-demo app",
        "version": "0.1.0",
        "copyright": "",
        "icon": ""
    },

    // module
    "modules": {
        "x-demo": {
            "label": "Demo",
            "version": "1.0.0",
            "icon": "",
            "copyright": "",
            "defaults": {
                "component": { 
                    "renderEngine": "x",
                    "stateEngine": "proxy"
                },
                "page": { 
                    "renderEngine": "x",
                    "stateEngine": "proxy"
                }
            },
            "contract": {
                "events": {},
                "actions": {},
                "intents": {}
            },
            "menus":{
                "navigation": "/pages",
                "tools": [
                    { "label": "My things 2-2", "href": "/pages/index.js?a=2-2"},
                    { "label": "My things 1111", "href": "/pages/01-components/index.js?a=1"}
                ]
            },
            "routes":{
                "/something": "/pages/index.js",
                "/repository/{repositoryId}/projects/{projectId}/items": "/pages/index.js"
            }
        },
        // references
        "x":                    {"configUrl": "url:../x/module.jsonc"},
        "xshell-diagnostics":   {"configUrl": "url:../xshell-diagnostics/module.jsonc"},
        "xshell-docs":          {"configUrl": "url:../xshell-docs/module.jsonc"}
    },

    // xshell 
    "xshell": {
        "areas": {
            "default": "demo",
            "definitions": {
                "demo": {
                    "prefix": "demo",
                    "label": "Demo",
                    "description": "Demo area for the x-demo app",
                    "icon": "",
                    "modules": [ "x-demo" ]
                }
            }
        }
    }

}
