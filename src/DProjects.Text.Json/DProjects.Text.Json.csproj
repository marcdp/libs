<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <AssemblyTitle>DProjects.Text.Json</AssemblyTitle>
        <TargetFramework>netstandard2.0</TargetFramework>
        <LangVersion>preview</LangVersion>
        <AssemblyName>DProjects.Text.Json</AssemblyName>
        <OutputType>Library</OutputType>
        <PackageId>DProjects.Text.Json</PackageId>
        <GenerateRuntimeConfigurationFiles>true</GenerateRuntimeConfigurationFiles>
        <RootNamespace />
        <ApplicationIcon />
        <OutputTypeEx>library</OutputTypeEx>
        <StartupObject />
        <Company>DProjects</Company>
        <Description>DProjects.Text.Json</Description>
        <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
        <Version>3.0.0</Version>
        <Authors>marcdp</Authors>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <Copyright>Copyright © DProjects SLU</Copyright>
        <Nullable>enable</Nullable>
        <PackageProjectUrl>https://www.dprojects.com/</PackageProjectUrl>
        <PackageIcon></PackageIcon>
    </PropertyGroup>
 
    <ItemGroup>
      <ProjectReference Include="..\DProjects.DataObjects\DProjects.DataObjects.csproj" />
      <ProjectReference Include="..\DProjects.DataTypes\DProjects.DataTypes.csproj" />
      <ProjectReference Include="..\DProjects.Serialization.Abstractions\DProjects.Serialization.Abstractions.csproj" />
      <ProjectReference Include="..\DProjects.Utils\DProjects.Utils.csproj" />
    </ItemGroup>

</Project>
