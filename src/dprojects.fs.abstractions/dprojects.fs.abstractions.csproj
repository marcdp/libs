<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyTitle>DProjects.Fs.Abstractions</AssemblyTitle>
    <TargetFramework>netstandard2.0</TargetFramework>
	<LangVersion>preview</LangVersion>
    <AssemblyName>DProjects.Fs.Abstractions</AssemblyName>
    <OutputType>Library</OutputType>
    <PackageId>DProjects.Fs.Abstractions</PackageId>
    <GenerateRuntimeConfigurationFiles>true</GenerateRuntimeConfigurationFiles>
    <RootNamespace />
    <ApplicationIcon />
    <OutputTypeEx>library</OutputTypeEx>
    <StartupObject />
    <Company>DProjects</Company>
    <Description>DProjects.Fs.Abstractions</Description>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <Version>3.0.0</Version>
    <Authors>marcdp</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Copyright>Copyright © DProjects SLU</Copyright>
    <Nullable>enable</Nullable>
    <PackageProjectUrl>https://www.dprojects.com/</PackageProjectUrl>
    <PackageIcon></PackageIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" Version="9.0.8" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="9.0.8" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DProjects.Utils\DProjects.Utils.csproj" />
  </ItemGroup>

</Project>
