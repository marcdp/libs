<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <AssemblyTitle>DProjects.Azure</AssemblyTitle>
        <TargetFramework>netstandard2.0</TargetFramework>
        <LangVersion>preview</LangVersion>
        <AssemblyName>DProjects.Azure</AssemblyName>
        <OutputType>Library</OutputType>
        <PackageId>DProjects.Azure</PackageId>
        <GenerateRuntimeConfigurationFiles>true</GenerateRuntimeConfigurationFiles>
        <RootNamespace />
        <ApplicationIcon />
        <OutputTypeEx>library</OutputTypeEx>
        <StartupObject />
        <Company>DProjects</Company>
        <Description>DProjects.Azure</Description>
        <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
        <Version>3.0.0</Version>
        <Authors>marcdp</Authors>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <Copyright>Copyright © DProjects SLU</Copyright>
        <Nullable>enable</Nullable>
        <PackageProjectUrl>https://www.dprojects.com/</PackageProjectUrl>
        <PackageIcon></PackageIcon>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="Microsoft.Graph" Version="5.93.0" />
        <PackageReference Include="Microsoft.Identity.Client" Version="4.77.0" />
    </ItemGroup>
    <ItemGroup>
      <ProjectReference Include="..\DProjects.Db.Abstractions\DProjects.Db.Abstractions.csproj" />
      <ProjectReference Include="..\DProjects.Db\DProjects.Db.csproj" />
      <ProjectReference Include="..\DProjects.Factories.Abstractions\DProjects.Factories.Abstractions.csproj" />
      <ProjectReference Include="..\DProjects.Fs.Abstractions\DProjects.Fs.Abstractions.csproj" />
      <ProjectReference Include="..\DProjects.Streams\DProjects.Streams.csproj" />
      <ProjectReference Include="..\DProjects.Text.Json\DProjects.Text.Json.csproj" />
      <ProjectReference Include="..\DProjects.Utils\DProjects.Utils.csproj" />
    </ItemGroup>

</Project>
