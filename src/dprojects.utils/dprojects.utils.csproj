<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
      <AssemblyTitle>DProjects.Utils</AssemblyTitle>
      <TargetFramework>netstandard2.0</TargetFramework>
      <LangVersion>preview</LangVersion>
      <AssemblyName>DProjects.Utils</AssemblyName>
      <Company>DProjects</Company>
      <Description>DProjects.Utils</Description>
      <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
      <Version>3.0.0</Version>
      <Authors>marcdp</Authors>
      <PackageLicenseExpression>MIT</PackageLicenseExpression>
      <Copyright>Copyright © DProjects SLU</Copyright>
      <Nullable>enable</Nullable>
      <PackageProjectUrl>https://www.dprojects.com/</PackageProjectUrl>
      <PackageIcon></PackageIcon>
      <CLSCompliant>true</CLSCompliant>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" Version="8.0.0" />
    <PackageReference Include="System.Text.Encoding.CodePages" Version="8.0.0" />
    <PackageReference Include="System.Text.Json" Version="8.0.3" />
  </ItemGroup>

</Project>
